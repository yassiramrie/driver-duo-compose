# Copy file ini jadi .env, lalu isi nilainya. File .env jangan di-push.

# Dipakai container database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Pakai password heksadesimal agar aman dipakai di connection string.
# DATABASE_URL dibentuk di compose.yaml dari tiga nilai POSTGRES_* di atas.

# Dipakai aplikasi buat menandatangani cookie login. Bikin pakai: openssl rand -hex 32
SESSION_SECRET=
